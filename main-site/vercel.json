{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "cleanUrls": true,
    "regions": ["sin1"],
    "routes": [{
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(.*\\.(css|js|json|png|svg|ico|webmanifest))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/"
        }
    ],
    "headers": [{
            "source": "/(.*)",
            "headers": [{
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                }
            ]
        },
        {
            "source": "/api/(.*)",
            "headers": [{
                "key": "Cache-Control",
                "value": "s-maxage=30, stale-while-revalidate=60"
            }]
        },
        {
            "source": "/(style\\.css|app\\.js)",
            "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=31536000, immutable"
            }]
        }
    ]

}